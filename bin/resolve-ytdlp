#!/bin/sh
# Resolver for the music pipeline: one track in, one audio file out.
#
# Contract (spec/requirements.md, AC5/AC6/AC11):
#   resolve-ytdlp <artist> <title> <album>
# Exit 0 and the produced file on line 1 of stdout is success. A non-zero exit
# with a reason on stderr is failure, and the pipeline records it.
#
# The download is cached: the same artist and title is fetched once, and every
# later call answers with the cached file. Set MUSIC_RESOLVER_CACHE to move the
# cache, YTDLP to name another yt-dlp binary.
set -eu

if [ "$#" -lt 2 ]; then
    echo "usage: $0 <artist> <title> [album]" >&2
    exit 2
fi

artist=$1
title=$2

tool=${YTDLP:-}
if [ -z "$tool" ]; then
    tool=$(command -v yt-dlp || true)
fi
if [ -z "$tool" ]; then
    for candidate in "${HOME:-/root}/.local/bin/yt-dlp" /usr/local/bin/yt-dlp /usr/bin/yt-dlp; do
        if [ -x "$candidate" ]; then
            tool=$candidate
            break
        fi
    done
fi
if [ -z "$tool" ]; then
    echo "resolve-ytdlp: yt-dlp not found; install it or set YTDLP" >&2
    exit 3
fi

# A service started by systemd carries no HOME, so the cache must not depend on
# it: the variable wins, then HOME, then the working directory.
cache=${MUSIC_RESOLVER_CACHE:-${HOME:-$PWD}/.cache/music-pipeline/resolver}
mkdir -p "$cache"

key=$(printf '%s - %s' "$artist" "$title" | tr -c 'A-Za-z0-9 .\n-' '_' | cut -c1-120)
base="$cache/$key"

# A cached download answers at once, whatever container it arrived in.
for cached in "$base".*; do
    case "$cached" in
    *.jpg | *.jpeg | *.png | *.webp | *.part | *.json | *.ytdl) continue ;;
    esac
    if [ -f "$cached" ]; then
        printf '%s\n' "$cached"
        exit 0
    fi
done

# Several queries are tried in order: one is not enough. Adding the word
# "audio" makes YouTube answer with nothing for a number of tracks (exit 0, no
# file), and a dead first hit is common. `yt:` is a YouTube search, `sc:` a
# SoundCloud one.
reason="no query was tried"
tried=0
while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    prefix=${entry%%:*}
    text=${entry#*:}
    case "$prefix" in
    sc) search="scsearch1:$text" ;;
    *) search="ytsearch1:$text" ;;
    esac
    tried=$((tried + 1))

    set +e
    out=$(
        "$tool" \
            --no-playlist --no-progress --quiet --no-warnings \
            --no-simulate --no-part \
            --ignore-config \
            -f "bestaudio/best" \
            -x --audio-format best \
            --write-thumbnail --convert-thumbnails jpg \
            -o "$base.%(ext)s" \
            --print after_move:filepath \
            "$search" 2>&1
    )
    status=$?
    set -e

    # --print may add lines; the produced file is the last path-shaped line.
    file=$(printf '%s\n' "$out" | awk 'NF && $0 ~ /\//' | tail -1)
    if [ "$status" -eq 0 ] && [ -n "$file" ] && [ -f "$file" ]; then
        printf '%s\n' "$file"
        exit 0
    fi
    if [ -n "$out" ]; then
        reason=$(printf '%s\n' "$out" | tail -2 | tr '\n' ' ')
    else
        reason="exit $status, no output for $search"
    fi
done <<QUERIES
yt:$artist - $title audio
yt:$artist - $title
yt:$artist $title
sc:$artist - $title
QUERIES

echo "resolve-ytdlp: no source for $artist - $title after $tried queries ($reason)" >&2
exit 4
