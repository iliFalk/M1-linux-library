#!/usr/bin/env python3
"""Fetch the Spotify likes and playlists into the pipeline's two files.

    bin/spotify-fetch [--token PATH] [--out DIR]

Refreshes the stored refresh token, reads ``/me/tracks`` and ``/me/playlists``,
and writes ``likes.json`` and ``playlists.json`` (the shapes ``music sync`` and
``music playlists`` read). The refreshed token is written back so the next run
starts from the same file.

The token comes from the one-time authorization (``mac-pkce.py``) and lives at
``--token`` or ``$MUSIC_SPOTIFY_TOKEN``.
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from music import spotify, tmc

DEFAULT_TOKEN = "/opt/falknest/music-state/spotify.json"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="spotify-fetch", description=__doc__.splitlines()[0])
    parser.add_argument(
        "--token",
        default=os.environ.get("MUSIC_SPOTIFY_TOKEN") or DEFAULT_TOKEN,
        help=f"stored refresh token (default: {DEFAULT_TOKEN})",
    )
    parser.add_argument(
        "--out", default=".", help="where likes.json and playlists.json go (default: .)"
    )
    args = parser.parse_args(argv)

    try:
        token, refreshed = spotify.access_token(args.token)
        liked = spotify.likes(token)
        lists = spotify.playlists(token)
    except (OSError, ValueError, spotify.SpotifyError) as exc:
        print(f"spotify-fetch: {exc}", file=sys.stderr)
        return 2

    spotify.store_token(args.token, refreshed)
    likes_path, playlists_path = tmc.write(args.out, liked, lists)
    print(f"{likes_path}: {len(liked)} likes")
    print(f"{playlists_path}: {len(lists)} playlists")
    return 0


if __name__ == "__main__":
    sys.exit(main())
