# Copy this file to .env and replace every placeholder.
# .env is untracked and required; docker compose reads it automatically.

# --- music pipeline (bin/music) -------------------------------------------
# Root of the library the pipeline writes: <library_root>/<Artist>/<Album>/*.m4a
MUSIC_LIBRARY_ROOT=./library
# State directory: holds library.db and likes.json
MUSIC_STATE_DIR=./state
# Resolver command, shlex-split; called as <resolver...> <artist> <title> <album>
MUSIC_RESOLVER=resolver-placeholder --flag
# JSON export of liked tracks, used when no `spotify` executable is on PATH
MUSIC_SPOTIFY_EXPORT=./spotify-liked.json
# Optional: the encoder and the prober to call when they are not on PATH
MUSIC_FFMPEG=ffmpeg
MUSIC_FFPROBE=ffprobe
# Resolver calls that run at once: 1 to 3, default 3
MUSIC_CONCURRENCY=3

# --- Navidrome ------------------------------------------------------------
# Host address the port is published on: 127.0.0.1 keeps Navidrome on the
# Docker host only. Set 0.0.0.0 to reach it directly over the LAN (plain HTTP,
# no TLS); clearing it breaks the compose file.
NAVIDROME_BIND_ADDRESS=127.0.0.1
# Host port the web UI and the Subsonic API are published on
NAVIDROME_PORT=4533
# REQUIRED, no default: initial password for the built-in `admin` user (first
# run only). docker compose refuses to run while this is empty.
NAVIDROME_ADMIN_PASSWORD=
