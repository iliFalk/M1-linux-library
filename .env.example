# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Library root: the tree the pipeline writes and Navidrome mounts read-only.
MUSIC_ROOT=/home/USER/Music

# State directory holding likes.json and library.db.
MUSIC_STATE=./state

# Path to a Spotify JSON export; used when the `spotify` CLI is not present.
MUSIC_LIKES_EXPORT=

# Resolver command that turns artist/title/album into a file path; "fake" for the offline resolver.
MUSIC_RESOLVER=yt-dlp

# Extra arguments appended to the resolver command, shell-split.
MUSIC_RESOLVER_ARGS=

# ffmpeg binary.
MUSIC_FFMPEG=ffmpeg

# ffprobe binary.
MUSIC_FFPROBE=ffprobe

# Failed attempts before a track is parked.
MUSIC_MAX_ATTEMPTS=3

# Host port Navidrome is published on.
MUSIC_NAVIDROME_PORT=4533

# Navidrome admin username (passed to the container as ND_USERNAME).
MUSIC_NAVIDROME_USER=admin

# Navidrome admin password (passed to the container as ND_PASSWORD) - change before first start.
MUSIC_NAVIDROME_PASSWORD=change-me
